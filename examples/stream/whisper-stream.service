[Unit]
Description=Whisper Stream Real-time Transcription
After=default.target

[Service]
Type=simple
ExecStart=/home/sandro/whisper.cpp/build/bin/whisper-stream \
    -m /home/sandro/whisper.cpp/models/ggml-base.bin \
    --step 2000 \
    --length 8000 \
    --audio-ctx 512 \
    --language es \
    --vad-startup 10000 \
    --silence-timeout 180000 \
    --udp-host 192.168.40.20 \
    --udp-port 5555

# Restart policy
# whisper-stream exits cleanly when no voice detected or after silence timeout
Restart=always
RestartSec=90

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=whisper-stream

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target
